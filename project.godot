; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TECTICA"
config/version="1.18.0-beta"
config/icon="res://assets/icon.png"
config/description="TECTICA - top-down / first-person tactical shooter."
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/logo.png"
boot_splash/fullsize=false
run/main_scene="res://scenes/loading.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Community="*res://scripts/net/community.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=4

[physics]

common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
common/physics_interpolation=true

[rendering]

textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
